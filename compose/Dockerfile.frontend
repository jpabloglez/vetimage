# Frontend image, two targets.
#
#   dev    — the Vite dev server, with the source tree bind-mounted over it.
#   serve  — the built bundle behind nginx. What production should run.
#
# Both compose files name their target explicitly. Relying on "the last stage
# wins" would mean re-ordering this file silently changed what production runs,
# which is precisely the class of accident this image exists to fix: the prod
# compose file used to override only `restart:`, so it inherited
# `command: npm run dev` and served production from the dev server —
# unminified, with HMR, and needing 'unsafe-inline'/'unsafe-eval' in the CSP.

# ---------------------------------------------------------------------------
# Shared dependency layer
# ---------------------------------------------------------------------------
FROM node:22-slim AS deps

# Needed to build native modules in some medical imaging packages.
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /var/www/app/frontend
ENV PATH=/var/www/app/frontend/node_modules/.bin:$PATH

COPY ./app/frontend/package*.json ./
RUN npm install --legacy-peer-deps && npm cache clean --force

# ---------------------------------------------------------------------------
# Production bundle
# ---------------------------------------------------------------------------
FROM deps AS build

COPY ./app/frontend/ .

# Vite inlines `import.meta.env.*` at build time, so the API and WebSocket
# origins are baked into the bundle here — they cannot be changed by setting an
# environment variable on the running container. An image built for one
# deployment will not work against another.
ARG VITE_API_URL
ARG VITE_WS_URL
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_WS_URL=${VITE_WS_URL}

RUN npm run build

# ---------------------------------------------------------------------------
# Static server
# ---------------------------------------------------------------------------
FROM nginx:1.27-alpine AS serve

# Listens on 3000, not 80, so the port mapping and healthcheck that the dev
# target uses keep working unchanged.
COPY ./compose/nginx-frontend.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /var/www/app/frontend/dist /usr/share/nginx/html

# Substituted into the CSP at container start by the base image's entrypoint,
# so the policy tracks the deployment rather than being frozen at build time.
ENV CSP_CONNECT_SRC="'self'"
ENV CSP_REPORT_URI=""

EXPOSE 3000

# ---------------------------------------------------------------------------
# Development server  (kept last only for readability; the target is explicit)
# ---------------------------------------------------------------------------
FROM deps AS dev

COPY ./app/frontend/ .

RUN usermod --non-unique --uid 1000 www-data \
  && groupmod --non-unique --gid 1000 www-data \
  && chown -R www-data:www-data /var/www

USER www-data
EXPOSE 3000
