# DICOM Gateway Configuration

# Service
SERVICE_NAME=OpenMedLab DICOM Gateway
VERSION=0.1.0
ENVIRONMENT=development

# DICOM SCP Settings
DICOM_AE_TITLE=OPENMEDLAB
DICOM_PORT=11112
DICOM_HOST=0.0.0.0
DICOM_MAX_PDU_LENGTH=16384
DICOM_TIMEOUT=30
MAX_CONCURRENT_ASSOCIATIONS=10

# Storage
STORAGE_PATH=/app/storage/dicom-temp
MAX_STORAGE_GB=100

# Backend API
BACKEND_API_URL=http://backend:8000
BACKEND_API_KEY=

# Database
DATABASE_URL=postgresql://openmedlab:openmedlab@db:5432/openmedlab

# Redis/Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Security
ALLOWED_SOURCE_IPS=["0.0.0.0/0"]
ENABLE_TLS=false
TLS_CERT_PATH=
TLS_KEY_PATH=

# Processing
ENABLE_ANONYMIZATION=false
AUTO_FORWARD_TO_BACKEND=true

# Monitoring
ENABLE_PROMETHEUS=true
PROMETHEUS_PORT=9090

# API
API_PORT=8001
API_HOST=0.0.0.0

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console
